---
const phone = '5493764810919'
const message = 'Hola, quisiera realizar una consulta legal.'
const whatsappUrl = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`
---

<a
  class="whatsapp-button"
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contactar a Adrián Benítez y Asociados por WhatsApp"
  data-umami-event="Click WhatsApp flotante"
>
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
    <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37C7.27 7.97 6.5 8.69 6.5 10.15s1.06 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35m-5.42 7.4h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26C2.16 6.44 6.6 2.01 12.05 2c2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.89-9.88 9.89" />
  </svg>
  <span>WhatsApp</span>
</a>

<style>
  .whatsapp-button{position:fixed;z-index:30;right:1.4rem;bottom:1.4rem;display:inline-flex;align-items:center;gap:.55rem;min-height:54px;padding:.75rem 1rem;border:1px solid #fff6;border-radius:999px;color:#fff;background:#1fae55;box-shadow:0 14px 30px rgba(7,49,29,.3),0 0 0 0 rgba(31,174,85,.42);font-size:.78rem;font-weight:800;letter-spacing:.035em;transition:transform .2s ease,background .2s ease,box-shadow .2s ease;animation:whatsapp-pulse 2.5s infinite}
  .whatsapp-button:hover{background:#168d43;transform:translateY(-3px);box-shadow:0 18px 34px rgba(7,49,29,.35)}
  .whatsapp-button:active{transform:translateY(0)}
  .whatsapp-button svg{width:25px;height:25px;flex:0 0 auto}
  @keyframes whatsapp-pulse{0%,100%{box-shadow:0 14px 30px rgba(7,49,29,.3),0 0 0 0 rgba(31,174,85,.42)}70%{box-shadow:0 14px 30px rgba(7,49,29,.3),0 0 0 13px rgba(31,174,85,0)}}
  @media(max-width:640px){.whatsapp-button{right:1rem;bottom:1rem;width:56px;height:56px;min-height:0;justify-content:center;padding:0}.whatsapp-button span{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}}
  @media(prefers-reduced-motion:reduce){.whatsapp-button{animation:none}}
</style>
